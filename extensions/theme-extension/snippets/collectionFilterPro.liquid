<div id="cfp-overlay" class="cfp-overlay" aria-hidden="true"></div>

{% if template.name == 'search' %}
  <script>
    // Set the search page title to match the requested format: "Search - Store Name"
    document.title = "Search - {{ shop.name | escape }}";
  </script>
  <style>
    /*
     * Independent Architecture:
     * We no longer hide the native search header globally.
     */
  </style>

  {% assign s_heading = search_heading | default: 'Find your perfect dress' %}
  {% assign s_subheading = search_subheading | default: 'Refine the details. Discover the one.' %}
  {% assign default_banner_bg = theme_detected_bg | default: '#FAF7F5' %}
  {% assign s_bg = search_header_bg %}
  {% if s_bg == blank or s_bg == 'rgba(0,0,0,0)' %}
    {% assign s_bg = default_banner_bg %}
  {% endif %}
  {% assign s_text_color = search_header_text_color | default: '#111827' %}
  {% assign s_popular_enabled = show_popular_searches %}
  {% if s_popular_enabled == nil %}
    {% assign s_popular_enabled = true %}
  {% endif %}
  {% assign s_popular_label = popular_searches_label | default: 'Popular searches:' %}
  {% assign s_popular_items = popular_searches_items | default: 'Red dresses, Prom dresses, Wedding guest, Evening gowns' %}

  <div class="cfp-search-banner-wrapper" style="background-color: {{ s_bg }}; width: 100%; border-radius: 8px; padding: 30px 24px; box-sizing: border-box; text-align: center;">
    <div class="cfp-search-banner-inner" style="max-width: 680px; margin: 0 auto;">
      {% if s_heading != blank %}
        <h1 class="cfp-search-banner__title" style="color: {{ s_text_color }}; font-family: var(--font-heading-family, Georgia, serif); font-size: 38px; font-weight: 400; line-height: 1.25; margin: 0 0 10px; letter-spacing: -0.01em;">
          {{ s_heading | escape }}
        </h1>
      {% endif %}
      {% if s_subheading != blank %}
        <p class="cfp-search-banner__subtitle" style="color: {{ s_text_color }}; opacity: 0.75; font-size: 15.5px; margin: 0 0 24px; line-height: 1.4;">
          {{ s_subheading | escape }}
        </p>
      {% endif %}

      <form action="{{ routes.search_url }}" method="get" class="cfp-inline-search-form" style="margin: 0 auto; max-width: 640px;">
        <div class="field cfp-search-input-field">
          <button type="submit" class="cfp-search-icon-btn" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
          <input
            class="field__input cfp-search-main-input"
            id="Cfp-Search-In-Template"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search..."
            autocomplete="off"
          >
          <button type="button" class="field__clear-button" id="Cfp-Clear-Search-Btn" aria-label="Clear Search" style="display: {% if search.terms != blank %}flex{% else %}none{% endif %};">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </form>

      {% if s_popular_enabled and s_popular_items != blank %}
        {% assign items_array = s_popular_items | split: ',' %}
        <div class="cfp-popular-searches" style="margin-top: 16px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px;">
          {% if s_popular_label != blank %}
            <span class="cfp-popular-searches__label" style="font-size: 13px; color: {{ s_text_color }}; opacity: 0.65; margin-right: 4px;">{{ s_popular_label }}</span>
          {% endif %}
          {% for item in items_array %}
            {% assign clean_item = item | strip %}
            {% if clean_item != blank %}
              {% assign is_current_term = false %}
              {% assign search_terms_lower = search.terms | downcase %}
              {% assign clean_item_lower = clean_item | downcase %}
              {% if search.terms != blank and search_terms_lower == clean_item_lower %}
                {% assign is_current_term = true %}
              {% endif %}
              <a href="{{ routes.search_url }}?q={{ clean_item | url_encode }}" class="cfp-popular-search-chip{% if is_current_term %} is-active{% endif %}" data-term="{{ clean_item | escape }}">
                {{ clean_item | escape }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('Cfp-Search-In-Template');
        var clearBtn = document.getElementById('Cfp-Clear-Search-Btn');
        if (searchInput && clearBtn) {
          function toggleClearBtn() {
            clearBtn.style.display = searchInput.value.length > 0 ? 'flex' : 'none';
          }
          toggleClearBtn();
          searchInput.addEventListener('input', toggleClearBtn);

          clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            toggleClearBtn();
            searchInput.focus();
            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
          });
        }
      });
    </script>
  </div>
{% endif %}

