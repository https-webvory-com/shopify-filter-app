{% if template.name == 'search' %}
  <script>
    // Set the search page title to match the requested format: "Search - Store Name"
    document.title = "Search - {{ shop.name | escape }}";
  </script>
  <style>
    /*
     * Independent Architecture:
     * We no longer hide the native search header globally.
     */
  </style>

  <div class="cfp-page-header" style="text-align: center; margin: 40px auto; max-width: 600px;">
    <h1 style="margin-bottom: 20px; font-size: 28px;">Search</h1>

    <style>
        /* Force thin grey border and override Dawn's thick black borders */
        .cfp-inline-search-form .field:after,
        .cfp-inline-search-form .field:before {
          box-shadow: none !important;
          border: none !important;
        }
        .cfp-inline-search-form .field {
          border: 1px solid rgba(0, 0, 0, 0.2) !important;
          border-radius: 4px !important;
          background: #fff;
          display: flex !important;
          align-items: center !important;
          position: relative;
          height: 44px;
          overflow: hidden;
        }
        .cfp-inline-search-form .field__input {
          border: none !important;
          box-shadow: none !important;
          outline: none !important;
          width: 100% !important;
          height: 100% !important;
          padding: 0 40px 0 16px !important;
          margin: 0 !important;
          font-size: 16px !important;
          text-align: left !important;
          background: transparent !important;
        }

        /* Hide native WebKit search cancel button */
        .cfp-inline-search-form .field__input::-webkit-search-decoration,
        .cfp-inline-search-form .field__input::-webkit-search-cancel-button,
        .cfp-inline-search-form .field__input::-webkit-search-results-button,
        .cfp-inline-search-form .field__input::-webkit-search-results-decoration {
          -webkit-appearance: none !important;
          appearance: none !important;
        }

        .cfp-inline-search-form .field__input:focus {
          box-shadow: none !important;
          outline: none !important;
        }
        .cfp-inline-search-form .field__label {
          display: none !important; /* Hide floating label, we will use standard placeholder */
        }
        .cfp-inline-search-form .field__button {
          position: absolute;
          right: 0;
          top: 0;
          height: 100%;
          width: 44px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: transparent;
          border: none;
          cursor: pointer;
          color: rgba(0,0,0,0.6);
        }
        .cfp-inline-search-form .field__clear-button {
          position: absolute;
          right: 44px; /* Before search icon */
          top: 0;
          height: 100%;
          width: 30px;
          display: none; /* Show only when there is text */
          align-items: center;
          justify-content: center;
          background: transparent;
          border: none;
          cursor: pointer;
          color: rgba(0,0,0,0.4);
        }
        .cfp-inline-search-form .field__clear-button:hover {
          color: rgba(0,0,0,0.8);
        }
      </style>

      <form action="{{ routes.search_url }}" method="get" class="cfp-inline-search-form" style="margin-bottom: 20px;">
        <div class="field">
          <input
            class="field__input"
            id="Cfp-Search-In-Template"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search for..."
          >
          <button type="button" class="field__clear-button" id="Cfp-Clear-Search-Btn" aria-label="Clear Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
          <button type="submit" class="field__button" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </div>
      </form>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          var searchInput = document.getElementById('Cfp-Search-In-Template');
          var clearBtn = document.getElementById('Cfp-Clear-Search-Btn');
          if (searchInput && clearBtn) {
            function toggleClearBtn() {
              clearBtn.style.display = searchInput.value.length > 0 ? 'flex' : 'none';
            }
            toggleClearBtn();
            searchInput.addEventListener('input', toggleClearBtn);

            clearBtn.addEventListener('click', function() {
              searchInput.value = '';
              toggleClearBtn();
              searchInput.focus();
              searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            });
          }
        });
      </script>
  </div>
{% endif %}

