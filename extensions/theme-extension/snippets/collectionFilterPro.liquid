<script>
  document.documentElement.classList.add('cfp-loading-init');
  setTimeout(() => document.documentElement.classList.remove('cfp-loading-init'), 2000);
</script>
<style>
  html.cfp-loading-init .product-grid,
  html.cfp-loading-init #product-grid,
  html.cfp-loading-init .collection-grid,
  html.cfp-loading-init ul.grid,
  html.cfp-loading-init #CollectionProductGrid {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>
{{ 'collectionFilterPro.css' | asset_url | stylesheet_tag }}

{%- style -%}
  :root {
    /* Correctly wrapping Dawn RGB variables in rgb() */
    --cfp-accent: rgb(var(--color-button, var(--color-base-accent-1, var(--color-base-text, 18, 18, 18))));
    --cfp-accent-text: rgb(var(--color-button-text, var(--color-base-background-1, 255, 255, 255)));
    
    --cfp-accent-hover: var(--cfp-accent);
    --cfp-accent-light: rgba(var(--color-base-text, 18, 18, 18), 0.05);
  }
{%- endstyle -%}

<div id="cfp-overlay" class="cfp-overlay" aria-hidden="true"></div>

<!-- Top Bar (Injected above products) -->
<div id="cfp-top-bar" class="cfp-top-bar" style="display:none;">
  <div class="cfp-top-bar__left">
    <button id="cfp-drawer-trigger-btn" class="cfp-drawer-trigger-btn" aria-label="Open filters" aria-expanded="false" aria-controls="cfp-sidebar">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="21" y1="6" x2="14" y2="6"></line>
        <line x1="10" y1="6" x2="3" y2="6"></line>
        <line x1="21" y1="12" x2="12" y2="12"></line>
        <line x1="8" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="18" x2="16" y2="18"></line>
        <line x1="12" y1="18" x2="3" y2="18"></line>
        <circle cx="12" cy="6" r="2"></circle>
        <circle cx="10" cy="12" r="2"></circle>
        <circle cx="14" cy="18" r="2"></circle>
      </svg>
      <span>Filters</span>
      <span class="cfp-active-badge" id="cfp-active-count" style="display:none;">0</span>
    </button>
  </div>
  <div class="cfp-top-bar__right">
    <div class="cfp-custom-sort" id="cfp-custom-sort">
      <div class="cfp-custom-sort__trigger" id="cfp-custom-sort-trigger">
        <span id="cfp-custom-sort-label">Best selling</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </div>
      <div class="cfp-custom-sort__dropdown" id="cfp-custom-sort-dropdown">
        <div class="cfp-custom-sort__option" data-value="best-selling">Best selling</div>
        <div class="cfp-custom-sort__option" data-value="price-ascending">Price: Low to High</div>
        <div class="cfp-custom-sort__option" data-value="price-descending">Price: High to Low</div>
        <div class="cfp-custom-sort__option" data-value="created-descending">Date: New to Old</div>
      </div>
    </div>
  </div>
</div>

<div id="cfp-breadcrumbs" class="cfp-breadcrumbs" style="display:none; width: 100%; margin-bottom: 20px;"></div>

<div id="cfp-sidebar" class="cfp-sidebar" data-shop="{{ shop.permanent_domain }}" data-template-name="{{ template.name }}" data-search-terms="{{ search.terms | escape }}" data-collection-id="{{ collection.id }}" data-collection-handle="{{ collection.handle }}" role="complementary" aria-label="Product Filters">
  <div class="cfp-sidebar__header">
    <div class="cfp-sidebar__header-info">
      <span class="cfp-sidebar__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        {{ filter_heading | default: 'Filters' }}
      </span>
    </div>
    <button id="cfp-close-btn" class="cfp-close-btn" aria-label="Close filters">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="cfp-sidebar__body">
    <!-- Dynamic filter groups injected here by collectionFilterPro.js -->
  </div>

  <div class="cfp-sidebar__footer">
    <button class="cfp-btn cfp-btn--apply-all" id="cfp-apply-btn">VIEW ALL RESULTS</button>
  </div>
</div>

<script>
  window.cfpCustomerTags = "{{ customer.tags | join: ',' }}";
  window.cfpCurrencySymbol = "{{ cart.currency.symbol }}";
  window.cfpCurrencyCode = "{{ cart.currency.iso_code }}";
</script>

<script src="{{ 'collectionFilterPro.js' | asset_url }}" defer="defer"></script>