{%- assign cfp_collection_handle = collection.handle | default: '' -%}
{%- assign cfp_collection_id = collection.id | default: '' -%}
{%- comment -%}Fallback: extract handle from URL path for automated/smart collections{%- endcomment -%}
{%- if cfp_collection_handle == '' -%}
  {%- assign cfp_path_parts = request.path | split: '/' -%}
  {%- assign cfp_collection_handle = cfp_path_parts | last -%}
{%- endif -%}

<!-- Start the collection request before stylesheets can block inline scripts. -->
<link rel="preconnect" href="https://aisearchfilter.webvory.com" crossorigin>
<script>
  window.cfpCustomerLoggedIn = {% if customer %}true{% else %}false{% endif %};
  window.cfpCustomerTags = "{{ customer.tags | join: ',' }}";
  window.cfpCurrencySymbol = "{{ cart.currency.symbol }}";
  window.cfpCurrencyCode = "{{ cart.currency.iso_code }}";

  window.collectionFilterProSettings = {
    show_price_filter: {{ show_price_filter | default: true | json }},
    show_brand_filter: {{ show_brand_filter | default: true | json }},
    show_color_filter: {{ show_color_filter | default: true | json }},
    show_size_filter: {{ show_size_filter | default: true | json }},
    show_availability_filter: {{ show_availability_filter | default: true | json }},
    accent_color: {{ accent_color | default: '#000000' | json }},
    filter_heading: {{ filter_heading | default: 'Filters' | json }},

    show_grid_border: {{ show_grid_border | default: false | json }},
    columns_desktop: {{ columns_desktop | default: 3 | json }},
    columns_mobile: {{ columns_mobile | default: "2" | json }},
    text_alignment: {{ text_alignment | default: "left" | json }},
    media_aspect_ratio: {{ media_aspect_ratio | default: "natural" | json }},
    image_size: {{ image_size | default: "cover" | json }},

    sale_label_position: {{ sale_label_position | default: "top-right" | json }},
    sale_bg_color: {{ sale_bg_color | default: "#FF4E4E" | json }},
    sale_text_color: {{ sale_text_color | default: "#FFFFFF" | json }},

    sold_out_label_position: {{ sold_out_label_position | default: "top-right" | json }},
    sold_out_bg_color: {{ sold_out_bg_color | default: "#000000" | json }},
    sold_out_text_color: {{ sold_out_text_color | default: "#FFFFFF" | json }}
  };

  /* ⚡ LIGHTHOUSE OPTIMIZATION: Fire API request immediately in inline script */
  (function() {
    try {
      var shop = "{{ shop.permanent_domain }}";
      var collHandle = "{{ cfp_collection_handle }}";
      var collId = "{{ cfp_collection_id }}";
      var params = new URLSearchParams(window.location.search);
      // Start an ordinary first page while the deferred storefront assets load.
      // The renderer must compare the complete context before consuming it.
      if (window.location.pathname.includes('/collections/') && params.get('sortBy') !== 'manual') {
        if (params.has('page') && params.get('page') !== '1') return;
        if ([...params.keys()].some(function(key) { return !['page','sortBy','rankingToken','preview_theme_id','_fd','_sc','pb','gclid','fbclid'].includes(key) && !key.startsWith('utm_'); })) return;
        var rankedParams = new URLSearchParams();
        rankedParams.set('locale', window.Shopify?.locale || document.documentElement.lang || '{{ request.locale.iso_code }}');
        rankedParams.set('shop', shop);
        var country=window.Shopify?.country||window.cfpCollectionContext?.country;
        if (country) rankedParams.set('country',country);
        if (window.cfpCustomerTags) rankedParams.set('customer_tags', window.cfpCustomerTags);
        if (collHandle) rankedParams.set('collectionHandle', collHandle);
        else if (collId) rankedParams.set('collectionId', collId);
        else return;
        rankedParams.set('sortBy', params.get('sortBy') || 'best-selling');
        rankedParams.set('page', '1'); rankedParams.set('limit', '25');
          rankedParams.set('responseProfile', window.cfpCustomerTags || !rankedParams.has('country') ? 'collection-v1' : ['best-selling','bestselling'].includes(rankedParams.get('sortBy'))?'collection-preview-v1':'collection-v2');
        rankedParams.sort();
        var earlyUrl = 'https://aisearchfilter.webvory.com/api/filter?' + rankedParams.toString();
        var previous=window._cfpRankedEarlyFetch;
        if(previous){
          var existing=new URL(previous.url);existing.searchParams.sort();
          if(existing.toString()===earlyUrl)return;
          previous.controller.abort();
        }
        var controller = new AbortController();
        var timeout = setTimeout(function() { controller.abort(); }, 30000);
        var configurationPromise = null;
        if (rankedParams.get('responseProfile') === 'collection-v2') {
          var configParams = new URLSearchParams(rankedParams);configParams.set('responseProfile','collection-config-v1');
          configurationPromise = fetch('https://aisearchfilter.webvory.com/api/filter?' + configParams.toString(),{signal:controller.signal,cache:'no-cache'})
            .then(function(response) { return response.ok ? response.json() : null; }).catch(function() { return null; });
        }
        window._cfpRankedEarlyFetch = {url:earlyUrl,controller:controller,configurationPromise:configurationPromise,promise:fetch(earlyUrl,{signal:controller.signal,cache:'no-cache'})
          .then(async function(response) { return {status:response.status,payload:await response.json()}; })
          .catch(function() { return null; })
          .finally(function() { Promise.resolve(configurationPromise).finally(function() { clearTimeout(timeout); }); })};
        return;
      }
      params.set('shop', shop);
      params.set('locale', window.Shopify?.locale || document.documentElement.lang || '{{ request.locale.iso_code }}');
      if (window.cfpCustomerTags) params.set('customer_tags', window.cfpCustomerTags);
      if (collHandle) params.set('collectionHandle', collHandle);
      if (collId && !collHandle) params.set('collectionId', collId);
      if (window.Shopify && window.Shopify.country) params.set('country', window.Shopify.country);

      var apiDomain = 'https://aisearchfilter.webvory.com';

      window._cfpEarlyFetch = fetch(apiDomain + '/api/filter?' + params.toString())
        .then(function(r) { return r.json(); })
        .catch(function(e) { return null; });
    } catch(e) {}
  })();
</script>

<style>
  /* ── Skeleton Loader CSS ─────────────────────────────────────── */
  @keyframes cfpSkShimmer {
    0% { background-position: -468px 0; }
    100% { background-position: 468px 0; }
  }
  .cfp-sk-anim {
    background: #e8e8e8;
    background-image: linear-gradient(to right, #e8e8e8 0%, #d0d0d0 20%, #e8e8e8 40%, #e8e8e8 100%);
    background-repeat: no-repeat;
    background-size: 800px 100%;
    animation: cfpSkShimmer 1.5s linear infinite forwards;
  }
  .cfp-sk-card { display: flex; flex-direction: column; gap: 12px; }
  .cfp-sk-image { width: 100%; aspect-ratio: 2/3; min-height: 280px; border-radius: 6px; display: block; }
  .cfp-sk-text { height: 12px; border-radius: 2px; display: block; }
  .cfp-sk-vendor { width: 40%; margin: 0 auto; }
  .cfp-sk-title { width: 80%; height: 16px; margin: 4px auto; display: block; }
  .cfp-sk-price { width: 30%; margin: 0 auto; }

  /* Products grid layout */
  .cfp-products-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(180px, 1fr)) !important;
    gap: 24px !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  @media (max-width: 1200px) { .cfp-products-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; } }
  @media (max-width: 900px) { .cfp-products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 16px !important; } }
  @media (max-width: 480px) { .cfp-products-grid { gap: 12px !important; } }

  /*
   * Independent Architecture:
   * We no longer hide the native grid globally.
   * The app will only mount inside the specific app block container.
   */

  /* Skeleton overlay: visible by default, hidden when done */
  #cfp-skeleton-overlay {
    display: grid !important;
  }
  #cfp-skeleton-overlay.cfp-skeleton-done {
    display: none !important;
  }
</style>

