<script>
(function() {
  var isSyncing = false;
  function getCurrentLayout() {
    if (window.innerWidth <= 768) {
      return window.cfpGlobalSettings?.mobileFilterLayout === 'horizontal-scrolling' ? 'horizontal-scrolling' : 'drawer';
    }

    // 2. If app JS runtime function is available, query it
    if (typeof window.cfpGetEffectiveLayout === 'function') {
      return window.cfpGetEffectiveLayout();
    }

    // 3. Check layout from global settings
    var layout = window.cfpGlobalSettings?.desktopFilterLayout ||
                 window.cfpGlobalSettings?.integrations?.desktopFilterLayout;
    if (layout === 'vertical') return 'vertical';
    if (layout === 'drawer') return 'drawer';
    if (layout === 'horizontal') return 'horizontal';

    // 4. Check if global setting explicitly disables it (e.g. horizontalFilters === false)
    if (window.cfpGlobalSettings && window.cfpGlobalSettings.horizontalFilters === false) {
      return 'drawer';
    }

    // 5. Default for tablet and desktop (> 768px): Horizontal is active!
    return 'horizontal';
  }

  function isCurrentHorizontal() {
    return getCurrentLayout() === 'horizontal';
  }

  function syncPillsLayout() {
    if (isSyncing) return;
    var hFilters = document.getElementById('cfp-horizontal-filters');
    var extra = document.getElementById('cfp-horizontal-extra-filters');
    var triggerBtn = document.getElementById('cfp-drawer-trigger-btn');
    var currentLayout = getCurrentLayout();

    if (currentLayout === 'vertical' || currentLayout === 'horizontal-scrolling') {
      if (hFilters) { hFilters.innerHTML = ''; hFilters.style.display = 'none'; }
      if (extra) { extra.innerHTML = ''; extra.style.display = 'none'; extra.classList.remove('is-expanded'); }
      if (triggerBtn) {
        triggerBtn.classList.add('is-hidden');
        triggerBtn.style.setProperty('display', 'none', 'important');
        triggerBtn.setAttribute('aria-expanded', 'false');
      }
      return;
    }

    if (currentLayout === 'drawer') {
      if (hFilters) { hFilters.innerHTML = ''; hFilters.style.display = 'none'; }
      if (extra) { extra.innerHTML = ''; extra.style.display = 'none'; extra.classList.remove('is-expanded'); }
      if (triggerBtn) {
        triggerBtn.classList.remove('is-hidden');
        triggerBtn.style.setProperty('display', 'inline-flex', 'important');
        var l = triggerBtn.querySelector('.cfp-drawer-btn-label');
        if (l) l.textContent = 'Filters';
        triggerBtn.setAttribute('aria-expanded', 'false');
      }
      return;
    }

    var topBar = document.getElementById('cfp-top-bar');
    var sortBox = topBar && topBar.querySelector('.cfp-top-bar__right') || document.getElementById('cfp-custom-sort');
    if (!topBar || !hFilters || !extra) return;

    var allPills = Array.from(topBar.querySelectorAll('.cfp-horizontal-pill'));
    if (allPills.length === 0) return;

    isSyncing = true;
    try {
      // Temporarily move all pills to hFilters to measure natural widths
      allPills.forEach(function(pill) {
        hFilters.appendChild(pill);
      });

      var mainRow = topBar.querySelector('.cfp-top-bar__main') || topBar;
      var rowStyle = getComputedStyle(mainRow);
      var topBarWidth = mainRow.clientWidth - (parseFloat(rowStyle.paddingLeft)||0) - (parseFloat(rowStyle.paddingRight)||0);
      var sortWidth = sortBox ? (sortBox.getBoundingClientRect().width || 140) : 140;
      var leftGap = parseFloat(getComputedStyle(hFilters.parentElement).columnGap)||12;
      var clearBtn = document.getElementById('cfp-clear-all-top');
      var clearRect = clearBtn && clearBtn.getBoundingClientRect();
      var clearStyle = clearBtn && getComputedStyle(clearBtn);
      var clearWidth = clearRect && clearRect.width ? clearRect.width + (parseFloat(clearStyle.marginLeft)||0) + (parseFloat(clearStyle.marginRight)||0) + leftGap : 0;

      // Available width for pills when NO MORE button is shown (reserve sort box + 28px gap)
      var availableWidthNoMore = Math.max(0, topBarWidth - sortWidth - (parseFloat(rowStyle.columnGap)||12) - clearWidth);

      var pillWidths = allPills.map(function(pill) {
        return Math.ceil(pill.getBoundingClientRect().width) || 105;
      });

      // Total width of all pills combined including 10px gap between each
      var totalPillsWidth = pillWidths.reduce(function(sum, w, i) {
        return sum + w + (i > 0 ? 10 : 0);
      }, 0);

      // Keep at most twelve groups in the primary row, even on wide screens.
      var maxPillsRow1 = 12;
      if (allPills.length <= maxPillsRow1 && totalPillsWidth <= availableWidthNoMore) {
        // All pills fit in Row 1!
        extra.innerHTML = '';
        extra.style.display = 'none';
        extra.classList.remove('is-expanded');

        if (triggerBtn) {
          triggerBtn.classList.add('is-hidden');
          triggerBtn.style.setProperty('display', 'none', 'important');
          triggerBtn.setAttribute('aria-expanded', 'false');
        }
      } else {
        // Extra filters cannot adjust in Row 1 -> show MORE button and place overflowing filters in Row 2
        if (triggerBtn) {
          triggerBtn.classList.remove('is-hidden');
          triggerBtn.style.setProperty('display','inline-flex','important');
        }
        var moreBtnWidth = triggerBtn ? (triggerBtn.getBoundingClientRect().width || 90) : 90;
        // Available width for pills in Row 1 when MORE button is present (sortWidth + moreBtnWidth + gaps)
        var availableWidthWithMore = Math.max(0, availableWidthNoMore - moreBtnWidth - leftGap);

        var currentWidth = 0;
        var primaryPills = [];
        var extraPills = [];

        allPills.forEach(function(pill, idx) {
          var pillWidth = pillWidths[idx];
          var neededWidth = (primaryPills.length === 0) ? pillWidth : (currentWidth + 10 + pillWidth);
          if (primaryPills.length < maxPillsRow1 && (primaryPills.length === 0 || neededWidth <= availableWidthWithMore)) {
            currentWidth = neededWidth;
            primaryPills.push(pill);
          } else {
            extraPills.push(pill);
          }
        });

        // Ensure primary pills in hFilters, extra in extraContainer
        primaryPills.forEach(function(pill) { hFilters.appendChild(pill); });
        extraPills.forEach(function(pill) { extra.appendChild(pill); });

        if (triggerBtn) {
          triggerBtn.classList.remove('is-hidden');
          triggerBtn.style.setProperty('display', 'inline-flex', 'important');
          var isExpanded = extra.classList.contains('is-expanded');
          var label = triggerBtn.querySelector('.cfp-drawer-btn-label');
          if (label) {
            label.textContent = isExpanded ? 'LESS' : 'MORE';
          }
          triggerBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        }

        if (extra.classList.contains('is-expanded') && extraPills.length > 0) {
          extra.style.display = 'flex';
        } else {
          extra.style.display = 'none';
        }
      }
    } finally {
      isSyncing = false;
    }
  }

  window.cfpSyncPillsLayout = syncPillsLayout;

  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(syncPillsLayout, 150);
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('#cfp-drawer-trigger-btn');
    if (!btn) return;

    var layout = getCurrentLayout();
    if (layout === 'vertical' || layout === 'horizontal-scrolling') {
      e.preventDefault();
      e.stopImmediatePropagation();
      return;
    }
    if (layout === 'drawer') return; // If mobile or drawer mode, allow normal drawer open

    e.preventDefault();
    e.stopImmediatePropagation();

    var extra = document.getElementById('cfp-horizontal-extra-filters');
    if (!extra) return;

    var isExpanded = extra.classList.toggle('is-expanded');
    extra.style.display = isExpanded ? 'flex' : 'none';
    var label = btn.querySelector('.cfp-drawer-btn-label');
    if (label) label.textContent = isExpanded ? 'LESS' : 'MORE';
    btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');

    var sb = document.getElementById('cfp-sidebar');
    if (sb) {
      sb.classList.remove('cfp-sidebar--open');
      sb.setAttribute('aria-hidden', 'true');
    }
    var ov = document.getElementById('cfp-overlay');
    if (ov) ov.classList.remove('cfp-overlay--visible');
    document.body.style.overflow = '';
  }, true);
})();
</script>


