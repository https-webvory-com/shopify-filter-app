{{ 'collectionFilterPro.css' | asset_url | stylesheet_tag }}

{%- style -%}
  :root {
    /* Correctly wrapping Dawn RGB variables in rgb() */
    --cfp-accent: rgb(var(--color-button, var(--color-base-accent-1, var(--color-base-text, 18, 18, 18))));
    --cfp-accent-text: rgb(var(--color-button-text, var(--color-base-background-1, 255, 255, 255)));
    
    --cfp-accent-hover: var(--cfp-accent);
    --cfp-accent-light: rgba(var(--color-base-text, 18, 18, 18), 0.05);
  }
{%- endstyle -%}

<div id="cfp-overlay" class="cfp-overlay" aria-hidden="true"></div>

<!-- Top Bar (Injected above products) -->
<div id="cfp-top-bar" class="cfp-top-bar" style="display:none;">
  <div class="cfp-top-bar__left">
    <span class="cfp-product-count">{{ collection.products_count }} products</span>
  </div>
  <div class="cfp-top-bar__right">
    <div class="cfp-sort-wrapper">
      <label for="cfp-sort-select-top">Sort by:</label>
      <select class="cfp-select-small" id="cfp-sort-select-top">
        <option value="manual">Featured</option>
        <option value="best-selling">Best Selling</option>
        <option value="title-ascending">A-Z</option>
        <option value="title-descending">Z-A</option>
        <option value="price-ascending">Price: Low-High</option>
        <option value="price-descending">Price: High-Low</option>
        <option value="created-ascending">Date: Old-New</option>
        <option value="created-descending">Date: New-Old</option>
      </select>
    </div>
  </div>
</div>

<div id="cfp-sidebar" class="cfp-sidebar" data-shop="{{ shop.permanent_domain }}" data-template-name="{{ template.name }}" data-search-terms="{{ search.terms | escape }}" data-collection-id="{{ collection.id }}" data-collection-handle="{{ collection.handle }}" role="complementary" aria-label="Product Filters">
  <div class="cfp-sidebar__header">
    <div class="cfp-sidebar__header-info">
      <span class="cfp-sidebar__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        {{ filter_heading | default: 'Filters' }}
      </span>
    </div>
    <button id="cfp-close-btn" class="cfp-close-btn" aria-label="Close filters">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="cfp-sidebar__body">
    <!-- Dynamic filter groups injected here by collectionFilterPro.js -->
  </div>

  <div class="cfp-sidebar__footer">
    <button class="cfp-btn cfp-btn--ghost" id="cfp-clear-btn">Clear All</button>
    <button class="cfp-btn cfp-btn--primary" id="cfp-apply-btn">Apply Filters</button>
  </div>
</div>

<!-- Mobile Filter Trigger Button -->
<button id="cfp-trigger-btn" class="cfp-trigger-btn" aria-label="Open filters" aria-expanded="false" aria-controls="cfp-sidebar">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
  <span>Filters</span>
  <span class="cfp-active-badge" id="cfp-active-count" style="display:none;">0</span>
</button>

<script>
  window.cfpCustomerTags = "{{ customer.tags | join: ',' }}";
</script>

<script src="{{ 'collectionFilterPro.js' | asset_url }}" defer="defer"></script>