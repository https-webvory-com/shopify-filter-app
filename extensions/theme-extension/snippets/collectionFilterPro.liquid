        <line x1="21" y1="6" x2="14" y2="6"></line>
        <line x1="10" y1="6" x2="3" y2="6"></line>
        <line x1="21" y1="12" x2="12" y2="12"></line>
        <line x1="8" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="18" x2="16" y2="18"></line>
        <line x1="12" y1="18" x2="3" y2="18"></line>
        <circle cx="12" cy="6" r="2"></circle>
        <circle cx="10" cy="12" r="2"></circle>
        <circle cx="14" cy="18" r="2"></circle>
      </svg>
      <span>Filters</span>
      <span class="cfp-active-badge" id="cfp-active-count" style="display:none;">0</span>
    </button>
  </div>
  <div class="cfp-top-bar__right">
    <div class="cfp-custom-sort" id="cfp-custom-sort">
      <div class="cfp-custom-sort__trigger" id="cfp-custom-sort-trigger">
        <span id="cfp-custom-sort-label">Best selling</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </div>
      <div class="cfp-custom-sort__dropdown" id="cfp-custom-sort-dropdown">
        <div class="cfp-custom-sort__option" data-value="best-selling">Best selling</div>
        <div class="cfp-custom-sort__option" data-value="price-ascending">Price: Low to High</div>
        <div class="cfp-custom-sort__option" data-value="price-descending">Price: High to Low</div>
        <div class="cfp-custom-sort__option" data-value="created-descending">Date: New to Old</div>
      </div>
    </div>
  </div>
</div>

<div id="cfp-breadcrumbs" class="cfp-breadcrumbs" style="display:none; width: 100%; margin-bottom: 20px;"></div>

<div id="cfp-sidebar" class="cfp-sidebar" data-shop="{{ shop.permanent_domain }}" data-template-name="{{ template.name }}" data-search-terms="{{ search.terms | escape }}" data-collection-id="{{ collection.id }}" data-collection-handle="{{ collection.handle }}" role="complementary" aria-label="Product Filters">
