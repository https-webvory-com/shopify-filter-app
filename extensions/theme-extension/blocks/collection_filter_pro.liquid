{% if template.name == 'collection' %}
  {% render 'collectionFilterPro',
    full_width: block.settings.full_width
  %}
{% endif %}

{% schema %}
{
  "name": "Collection Filter Pro",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Enable Full Width Layout",
      "default": true
    }
  ]
}
{% endschema %}
