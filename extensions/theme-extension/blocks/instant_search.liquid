<script>
  window.cfpCustomerLoggedIn = {% if customer %}true{% else %}false{% endif %};
  window.cfpCustomerTags = {{ customer.tags | join: ',' | json }};
  window.cfpCurrencySymbol = {{ cart.currency.symbol | json }};
  window.cfpCurrencyCode = {{ cart.currency.iso_code | json }};
  window.CFP_InstantSearchSettings = {
    customTriggerSelector: {{ block.settings.custom_trigger_selector | json }},
    primaryColor: {{ block.settings.primary_color | default: '#000000' | json }},
    productLimit: {{ block.settings.product_limit | default: 6 | json }}
  };
</script>
<script src="{{ 'marketPricing.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'searchSettings.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'instantSearch.js' | asset_url }}" defer="defer"></script>
{% if template.name == 'search' %}
  {{ 'searchBanners.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'searchBanners.js' | asset_url }}" defer="defer"></script>
{% endif %}
{{ 'instantSearch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quickViewAdapters.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quickView.js' | asset_url }}" defer="defer"></script>
{{ 'quickView.css' | asset_url | stylesheet_tag }}

<style>
  :root {
    --cfp-is-primary: {{ block.settings.primary_color | default: '#000000' }};
  }
</style>

{% schema %}
{
  "name": "AI Instant Search",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "custom_trigger_selector",
      "label": "Custom Search Selector",
      "info": "Leave blank unless your theme's search is not opening automatically. E.g. '.my-custom-search-btn'"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6
    }
  ]
}
{% endschema %}
