{% if template.name == 'collection' or template.name == 'search' or true %}
  <div id="cfp-global-settings" style="display:none;" 
    data-show-filters="{{ block.settings.show_filters }}"
    data-filter-position="{{ block.settings.filter_position }}"
    data-show-description="{{ block.settings.show_collection_description }}"
    data-primary-color="{{ block.settings.primary_color }}"
    data-show-collections="{{ block.settings.show_collections }}"
    data-show-blogs="{{ block.settings.show_blogs }}"
    data-show-pages="{{ block.settings.show_pages }}"
    data-suggestion-count="{{ block.settings.suggestion_count }}"
    data-desktop-columns="{{ block.settings.desktop_columns }}"
    data-mobile-columns="{{ block.settings.mobile_columns }}"
    data-show-border="{{ block.settings.show_grid_border }}"
    data-text-align="{{ block.settings.text_alignment }}"
    data-media-aspect="{{ block.settings.media_aspect_ratio }}"
    data-image-size="{{ block.settings.image_size }}"
    data-sale-label-type="{{ block.settings.sale_label_type }}"
    data-sale-label-pos="{{ block.settings.sale_label_position }}"
    data-sale-bg="{{ block.settings.sale_background_color }}"
    data-sale-text="{{ block.settings.sale_text_color }}"
    data-soldout-bg="{{ block.settings.soldout_background_color }}"
    data-soldout-text="{{ block.settings.soldout_text_color }}"
    data-soldout-pos="{{ block.settings.soldout_label_position }}">
  </div>

  {{ 'collectionFilterPro.css' | asset_url | stylesheet_tag }}
  {{ 'instantSearch.css' | asset_url | stylesheet_tag }}
{% endif %}

{% schema %}
{
  "name": "Collection Filter Pro V2",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "custom_grid_selector",
      "label": "Custom Grid CSS Selector",
      "info": "Leave blank to auto-detect (e.g. .product-grid)"
    },
    {
      "type": "text",
      "id": "custom_filters_selector",
      "label": "Custom Filters CSS Selector",
      "info": "Leave blank to auto-detect (e.g. .collection-filters)"
    },
    {
      "type": "text",
      "id": "custom_pagination_selector",
      "label": "Custom Pagination CSS Selector",
      "info": "Leave blank to auto-detect. Do NOT enter a number here!"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Collection Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Filters",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        { "value": "left", "label": "Left Sidebar" },
        { "value": "right", "label": "Right Sidebar" },
        { "value": "drawer", "label": "Off-canvas Drawer" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Instant Search Features"
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "Show Suggested Collections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_blogs",
      "label": "Show Suggested Articles",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pages",
      "label": "Show Suggested Pages",
      "default": false
    },
    {
      "type": "range",
      "id": "suggestion_count",
      "label": "Product Suggestions Count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Grid Layout (Global)"
    },
    {
      "type": "checkbox",
      "id": "show_grid_border",
      "label": "Show grid border",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media aspect ratio",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "rectangle", "label": "Rectangle" }
      ],
      "default": "rectangle"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size (Rectangle only)",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Sale badges (Global)"
    },
    {
      "type": "select",
      "id": "sale_label_type",
      "label": "Sale label type",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "percent", "label": "Percent" },
        { "value": "amount", "label": "Amount" }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "sale_label_position",
      "label": "Sale label position",
      "options": [
        { "value": "top-left", "label": "Top - left" },
        { "value": "top-right", "label": "Top - right" },
        { "value": "bottom-left", "label": "Bottom - left" },
        { "value": "bottom-right", "label": "Bottom - right" }
      ],
      "default": "top-left"
    },
    {
      "type": "color",
      "id": "sale_background_color",
      "label": "Sale background color",
      "default": "#FF4E4E"
    },
    {
      "type": "color",
      "id": "sale_text_color",
      "label": "Sale text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Sold out badges (Global)"
    },
    {
      "type": "color",
      "id": "soldout_background_color",
      "label": "Sold out background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "soldout_text_color",
      "label": "Sold out text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "soldout_label_position",
      "label": "Sold out label position",
      "options": [
        { "value": "top-left", "label": "Top - left" },
        { "value": "top-right", "label": "Top - right" },
        { "value": "bottom-left", "label": "Bottom - left" },
        { "value": "bottom-right", "label": "Bottom - right" }
      ],
      "default": "top-left"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Brand Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
