generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Product {
  id          String              @id
  shop        String
  title       String
  handle      String
  vendor      String
  productType String
  priceMin    Decimal             @db.Decimal(10, 2)
  priceMax    Decimal             @db.Decimal(10, 2)
  tags        String[]
  images      Json?
  status      String              @default("active")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Sales Metrics for Rankings
  unitsLifetime    Int      @default(0)   // All-time lifetime units sold
  unitsSold60Days  Int      @default(0)
  unitsSold7Days   Int      @default(0)
  grossRevenue     Float    @default(0.0)
  orderCount       Int      @default(0)
  bestSellingScore Float    @default(0.0)
  trendingScore    Float    @default(0.0)

  options         Json?
  collections     ProductCollection[]
  metafields      ProductMetafield[]
  variants        Variant[]

  @@index([shop, vendor])
  @@index([shop, productType])
  @@index([shop, priceMin, priceMax])
  @@index([options], type: Gin)
  @@index([productType(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([vendor(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Variant {
  id             String   @id
  productId      String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  available      Boolean  @default(true)
  inventory      Int      @default(0)
  option1        String?
  option2        String?
  option3        String?
  imageUrl       String?
  sku            String?
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([option1(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([option2(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([option3(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Collection {
  id       String              @id
  shop     String
  title    String
  handle   String
  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductMetafield {
  id        String  @id
  productId String
  namespace String
  key       String
  value     String
  type      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, namespace, key])
  @@index([namespace, key])
}

model FilterSetting {
  id          Int     @id @default(autoincrement())
  shop        String
  type        String
  label       String
  key         String?
  displayType String  @default("list")
  isEnabled   Boolean @default(true)
  order       Int     @default(0)

  @@unique([shop, type, key])
}

model FilterGroup {
  id          String                  @id @default(cuid())
  shop        String
  name        String
  isDefault   Boolean                 @default(false)
  status      Boolean                 @default(true)
  order       Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  collections FilterGroupCollection[]
  filters     FilterGroupItem[]
  savedViews  SavedFilterView[]

  @@index([shop])
}

model FilterGroupCollection {
  id              String      @id @default(cuid())
  filterGroupId   String
  collectionId    String
  collectionTitle String
  pageType        String      @default("collection")
  filterGroup     FilterGroup @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)

  @@index([filterGroupId])
}

model FilterGroupItem {
  id            String      @id @default(cuid())
  filterGroupId String
  filterType    String
  filterKey     String?
  label         String
  displayMode   String      @default("list")
  isEnabled     Boolean     @default(true)
  order         Int         @default(0)
  config        Json?
  filterGroup   FilterGroup @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)

  @@index([filterGroupId])
}

model SavedFilterView {
  id            String      @id @default(cuid())
  filterGroupId String
  name          String      @default("Custom Filter")
  matchType     String      @default("all")
  conditions    Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  filterGroup   FilterGroup @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)

  @@index([filterGroupId])
}

model MergedValue {
  id           String   @id @default(cuid())
  shop         String
  filterType   String
  filterKey    String?
  targetValue  String
  sourceValues String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)

  @@index([shop, filterType])
}

model MerchandisingRule {
  id            String                       @id @default(cuid())
  shop          String
  name          String
  collections   String[]
  customerTags  String?
  locales       String?
  startDate     DateTime?
  endDate       DateTime?
  status        Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  ruleType      String                       @default("collection")
  searchQueries String[]
  conditions    MerchandisingRuleCondition[]

  @@index([shop])
}

model MerchandisingRuleCondition {
  id        String            @id @default(cuid())
  ruleId    String
  action    String
  field     String
  value     String?
  operator  String?
  operand   String?
  minValue  String?
  maxValue  String?
  dateValue String?
  rule      MerchandisingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model PinnedProductRule {
  id                String   @id @default(cuid())
  shop              String
  products          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  status            Boolean  @default(true)
  applyToAll        Boolean  @default(false)
  collections       String[]
  name              String   @default("Pinning Rule")
  applyToSearchType String   @default("both")
  ruleType          String   @default("collection")
  searchQueries     String[]

  @@unique([shop, name, ruleType])
  @@index([shop])
}

model FilterGlobalSetting {
  id                                  Int      @id @default(autoincrement())
  shop                                String   @unique
  horizontalFilters                   Boolean  @default(false)
  mobileFilterLayout                  String   @default("off-canvas")
  showAttributeBasedBreadcrumb        Boolean  @default(true)
  showFilterOptionsWithOneItem        Boolean  @default(false)
  showProductCount                    Boolean  @default(true)
  scrollUpOnFilterValuesChange        Boolean  @default(false)
  hideUnavailableVariantsWhenSelected Boolean  @default(false)
  desktopLikeOnMobile                 Boolean  @default(false)
  darkMode                            Boolean  @default(false)
  showOnlyInStock                     Boolean  @default(false)
  prioritizeSortOverPinning           Boolean  @default(false)
  prioritizeSortOverMerchandising     Boolean  @default(false)
  secondImageOnHover                  Boolean  @default(true)
  showQuickViewInstantSearch          Boolean  @default(true)
  showQuickViewCollection             Boolean  @default(true)
  quickViewStyle                     String   @default("app")
  showQuickViewSizeChart              Boolean  @default(false)
  quickViewInstantSearchStyle        String?
  showQuickViewInstantSearchSizeChart Boolean?
  isWholesale                         Boolean  @default(false)
  integrations                        Json?
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
}

model SyncJob {
  id                String   @id @default(uuid())
  shop              String
  status            String   @default("IN_PROGRESS")
  cursor            String?
  productsProcessed Int      @default(0)
  totalProducts     Int?
  lastError         String?
  retryCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop, status])
}

model Synonym {
  id        String   @id @default(uuid())
  shop      String
  word      String // The target word, e.g., "dress"
  synonyms  String // Comma-separated list, e.g., "gown, frock"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shop, word])
}
